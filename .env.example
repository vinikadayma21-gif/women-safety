# =======================================================================
# NEON SERVERLESS POSTGRESQL (or any PostgreSQL)
# =======================================================================
# Pooled connection string (with ?sslmode=require&pgbouncer=true or pooled host)
DATABASE_URL="postgresql://username:password@ep-cool-pool-123456.us-east-2.aws.neon.tech/safecity_delhi?sslmode=require&pgbouncer=true"

# Direct connection string for Prisma migrations (non-pooled)
DIRECT_URL="postgresql://username:password@ep-cool-pool-123456.us-east-2.aws.neon.tech/safecity_delhi?sslmode=require"

# =======================================================================
# CLERK AUTHENTICATION (https://dashboard.clerk.com)
# =======================================================================
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_..."
CLERK_SECRET_KEY="sk_test_..."

# Clerk Webhook Secret (from Clerk Dashboard -> Webhooks -> Add Endpoint -> Signing Secret)
CLERK_WEBHOOK_SECRET="whsec_..."

# Clerk Route Handlers
NEXT_PUBLIC_CLERK_SIGN_IN_URL="/sign-in"
NEXT_PUBLIC_CLERK_SIGN_UP_URL="/sign-up"
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL="/"
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL="/"

# =======================================================================
# GOOGLE MAPS PLATFORM (PLANv2)
# https://console.cloud.google.com
# Required APIs:
#   - Maps JavaScript API
#   - Places API (New)
#   - Distance Matrix API
#   - Geocoding API
#   - Maps Static API
# =======================================================================
# Browser API Key (Restrict to HTTP referrers: localhost:3000/*, yourdomain.com/*)
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY="AIza..."

# Dark Theme Map ID (Google Maps Platform > Map Styles > Create Map ID > Select Dark theme)
NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID="your-map-id"

# Server API Key (Restrict to Places API, Distance Matrix API, Geocoding API — Server-only)
GOOGLE_MAPS_SERVER_KEY="AIza..."

# =======================================================================
# UPSTASH REDIS (PLANv2)
# https://console.upstash.com (Serverless Redis for safety score & places caching)
# =======================================================================
UPSTASH_REDIS_REST_URL="https://..."
UPSTASH_REDIS_REST_TOKEN="AXxx..."

# =======================================================================
# OPENWEATHERMAP API (PLANv2)
# https://openweathermap.org/api (Weather multiplier for WSI safety scoring)
# =======================================================================
OPENWEATHER_API_KEY="your-key-here"

# =======================================================================
# APPLICATION CONFIGURATION
# =======================================================================
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_DEFAULT_LAT="28.6139"
NEXT_PUBLIC_DEFAULT_LNG="77.2090"
NEXT_PUBLIC_DEFAULT_REGION="Delhi NCR"
